@page "/support-list"
@rendermode InteractiveServer
@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDb

<PageTitle>Support-henvendelser</PageTitle>

<h1>Support-henvendelser</h1>

<p>
    <a href="/create-support">+ Opret ny henvendelse</a>
</p>

<div class="mb-3">
    <label for="categoryFilter" class="form-label">Filtrér på kategori</label>
    <select id="categoryFilter" class="form-control" style="max-width: 300px;" @bind="selectedCategory" @bind:after="LoadMessagesAsync">
        <option value="">Alle</option>
        <option value="Teknisk">Teknisk</option>
        <option value="Reservedele">Reservedele</option>
        <option value="Ændringsforslag">Ændringsforslag</option>
        <option value="Forhandler">Forhandler</option>
        <option value="Katalog">Katalog</option>
        <option value="Andet">Andet</option>
    </select>
</div>

@if (messages == null)
{
    <p>Indlæser...</p>
}
else if (messages.Count == 0)
{
    <p>Der er endnu ingen henvendelser.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Email</th>
            <th>Kategori</th>
            <th>Beskrivelse</th>
            <th>Dato</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var message in messages)
        {
            <tr>
                <td>@message.Name</td>
                <td>@message.Email</td>
                <td>@message.Category</td>
                <td>@message.Description</td>
                <td>@message.Timestamp.ToString("dd-MM-yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage>? messages;
    private string selectedCategory = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMessagesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        messages = string.IsNullOrEmpty(selectedCategory)
            ? await CosmosDb.GetAllSupportMessagesAsync()
            : await CosmosDb.GetSupportMsgByCategoryAsync(selectedCategory);
    }
}